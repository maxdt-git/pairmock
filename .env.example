POSTGRES_USER=transcendence
POSTGRES_PASSWORD=yourpass
POSTGRES_DB=transcendence
DATABASE_URL=postgresql://transcendence:yourpass@db:5432/transcendence?schema=public
BETTER_AUTH_SECRET=yoursecret
BETTER_AUTH_URL=https://localhost:8443
GOOGLE_CLIENT_ID=see-NOTE.md-to-configure
GOOGLE_CLIENT_SECRET=see-NOTE.md-to-configure
AI_API_KEYS=yourgroqapikey
#--- Production / Deployment overrides
BUILD_TARGET=prod                 # Multi-stage Dockerfile target: "dev" (default) or "prod" (Nginx + compiled JS)
DOMAIN_NAME=pairmock.duckdns.org  # Public domain for Caddy automatic Let's Encrypt HTTPS (defaults to "localhost")
CADDY_HTTP_PORT=80                # Public HTTP port for Caddy (defaults to "127.0.0.1:8080")
CADDY_HTTPS_PORT=443              # Public HTTPS port for Caddy (defaults to "127.0.0.1:8443")
